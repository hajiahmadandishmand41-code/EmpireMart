{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/(build|assets|themes|images|storage)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|sitemap\\.xml|manifest\\.json|.*\\.(css|js|map|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2|ttf|eot|txt|xml|json))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
